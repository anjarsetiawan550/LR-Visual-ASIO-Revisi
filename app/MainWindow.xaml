<Window x:Class="LRVisualASIO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LR Visual ASIO" Width="640" Height="600" SizeToContent="Manual" Icon="Assets/icon.ico"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">
    <Window.Resources>
        <DataTemplate x:Key="DeviceTpl">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
        </DataTemplate>
        <LinearGradientBrush x:Key="MeterBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00E5A0" Offset="0"/>
            <GradientStop Color="#00B7FF" Offset="0.7"/>
            <GradientStop Color="#9B7BFF" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="9,4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#26264F"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#CC10102A"/>
            <Setter Property="BorderBrush" Value="#33336B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8F8FC8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,8"/>
        </Style>
        <Style x:Key="RowL" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9A9AC8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RowV" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E8E8FF"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="Chip" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B8B8E0"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="#1B1B3A" BorderBrush="#33336B" BorderThickness="1" CornerRadius="9" Padding="12,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#7A6BFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#5B4BFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#00E5FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="track" Width="56" Height="28" CornerRadius="14" Background="#2A2A55" BorderBrush="#44448A" BorderThickness="1">
                            <Ellipse x:Name="knob" Width="20" Height="20" Fill="#9A9AD0" HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#00B894"/>
                                <Setter TargetName="track" Property="BorderBrush" Value="#00E5C0"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,4,0"/>
                                <Setter TargetName="knob" Property="Fill" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E6E6FF"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#2E2E66"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="b" Property="Background" Value="#3D35A8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E6E6FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton ClickMode="Press" Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#1B1B3A" BorderBrush="#44448A" BorderThickness="1" CornerRadius="9">
                                            <Path Data="M0,0 L5,5 L10,0" Stroke="#00E5FF" StrokeThickness="2"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter IsHitTestVisible="False" Margin="12,0,34,0" VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260" Background="#14142B"
                                        BorderBrush="#5B4BFF" BorderThickness="1" CornerRadius="9" Margin="0,4,0,0" Padding="4">
                                    <ScrollViewer><StackPanel IsItemsHost="True"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#B8B8E0"/>
            <Setter Property="Width" Value="34"/><Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#33336B"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Apply" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="11">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#5B4BFF" Offset="0"/>
                                    <GradientStop Color="#00B7FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
    <Viewbox x:Name="Scaler" Stretch="Uniform">
    <Border x:Name="RootCard" Width="860" Margin="12" CornerRadius="20" BorderThickness="1.5">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#080818" Offset="0"/>
                <GradientStop Color="#14103A" Offset="0.6"/>
                <GradientStop Color="#0A1F3A" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#7A6BFF" Offset="0"/>
                <GradientStop Color="#00E5FF" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="0" Color="#7A6BFF" Opacity="0.55"/>
        </Border.Effect>

        <Grid Margin="26,18,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid x:Name="Header" Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <StackPanel>
                    <TextBlock Text="LR VISUAL ASIO" FontSize="30" FontWeight="Black">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00E5FF" Offset="0"/>
                                <GradientStop Color="#9B7BFF" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                        <TextBlock.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="0" Color="#7A6BFF" Opacity="0.9"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="WDM  →  ASIO   •   Virtual Low-Latency Audio Driver" Foreground="#8F8FC8" FontSize="12" Margin="2,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource WinBtn}" Content="—" Click="Min_Click"/>
                    <Button Style="{StaticResource WinBtn}" Content="✕" Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- Body -->
            <Grid Grid.Row="1" Margin="0,18,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Pengaturan -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="PENGATURAN" Foreground="#00E5FF" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>
                            <Button Content="⟳  Segarkan perangkat" Style="{StaticResource Ghost}" HorizontalAlignment="Right" Click="Refresh_Click"/>
                        </Grid>

                        <TextBlock Text="OUTPUT DEVICE (WDM)" Style="{StaticResource Cap}"/>
                        <ComboBox x:Name="CmbOut" ItemTemplate="{StaticResource DeviceTpl}"/>
                        <TextBlock Text="INPUT DEVICE (WDM)" Style="{StaticResource Cap}"/>
                        <ComboBox x:Name="CmbIn" ItemTemplate="{StaticResource DeviceTpl}"/>

                        <TextBlock Text="SAMPLE RATE" Style="{StaticResource Cap}"/>
                        <WrapPanel x:Name="RatePanel"/>

                        <TextBlock Text="ASIO BUFFER (SAMPLES)" Style="{StaticResource Cap}" Margin="0,8,0,8"/>
                        <WrapPanel x:Name="BufPanel"/>
                        <TextBlock x:Name="BufInfo" Foreground="#00E5FF" FontSize="12" Margin="0,-2,0,0"/>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="SAFE MODE" Foreground="#E8E8FF" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="Mode shared: lebih stabil &amp; tidak mengunci perangkat. Matikan untuk latensi minimum (Exclusive)."
                                           Foreground="#8F8FC8" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,16,0"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkSafe" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="MULAI OTOMATIS DENGAN WINDOWS" Foreground="#E8E8FF" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="Berjalan di latar belakang (ikon tray). Bisa juga dimatikan di Task Manager → Startup apps."
                                           Foreground="#8F8FC8" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,16,0"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkAuto" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Auto_Click"/>
                        </Grid>

                        <Button Content="TERAPKAN PENGATURAN" Style="{StaticResource Apply}" Margin="0,22,0,0" Click="Apply_Click"/>
                        <TextBlock x:Name="Note" Foreground="#8F8FC8" FontSize="11.5" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Status -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="ASIO STATUS" Foreground="#00E5FF" FontWeight="Bold" FontSize="13"/>

                        <Border x:Name="Pill" Margin="0,16,0,6" CornerRadius="12" Padding="14,12" Background="#2A1A2E" BorderBrush="#FF4D6D" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="Dot" Width="14" Height="14" Fill="#FF4D6D" VerticalAlignment="Center">
                                    <Ellipse.Effect><DropShadowEffect x:Name="DotGlow" BlurRadius="12" ShadowDepth="0" Color="#FF4D6D"/></Ellipse.Effect>
                                </Ellipse>
                                <StackPanel Margin="12,0,0,0">
                                    <TextBlock x:Name="StatusText" Text="NONAKTIF" FontSize="18" FontWeight="Black" Foreground="White"/>
                                    <TextBlock x:Name="StatusSub" Text="Menunggu DAW" FontSize="11" Foreground="#B8B8E0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Sample Rate" Style="{StaticResource RowL}"/>
                            <TextBlock x:Name="ValRate" Grid.Column="1" Text="—" Style="{StaticResource RowV}"/></Grid>
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Buffer" Style="{StaticResource RowL}"/>
                            <TextBlock x:Name="ValBuf" Grid.Column="1" Text="—" Style="{StaticResource RowV}"/></Grid>
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Input Latency" Style="{StaticResource RowL}"/>
                            <TextBlock x:Name="ValIn" Grid.Column="1" Text="—" Style="{StaticResource RowV}"/></Grid>
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Output Latency" Style="{StaticResource RowL}"/>
                            <TextBlock x:Name="ValOut" Grid.Column="1" Text="—" Style="{StaticResource RowV}"/></Grid>
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Round-trip" Style="{StaticResource RowL}"/>
                            <TextBlock x:Name="ValRtt" Grid.Column="1" Text="—" Style="{StaticResource RowV}"/></Grid>
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Buffer Perangkat" Style="{StaticResource RowL}"/>
                            <TextBlock x:Name="ValDev" Grid.Column="1" Text="—" Style="{StaticResource RowV}"/></Grid>
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Mode" Style="{StaticResource RowL}"/>
                            <TextBlock x:Name="ValMode" Grid.Column="1" Text="—" Style="{StaticResource RowV}"/></Grid>
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="Channel I/O" Style="{StaticResource RowL}"/>
                            <TextBlock x:Name="ValCh" Grid.Column="1" Text="—" Style="{StaticResource RowV}"/></Grid>

                        <TextBlock Text="LEVEL" Style="{StaticResource Cap}"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="IN" Style="{StaticResource RowL}" FontSize="11"/>
                            <Border x:Name="MeterInTrack" Grid.Column="1" Height="8" CornerRadius="4" Background="#1B1B3A" VerticalAlignment="Center">
                                <Border x:Name="MeterIn" Width="0" HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource MeterBrush}"/>
                            </Border>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <TextBlock Text="OUT" Style="{StaticResource RowL}" FontSize="11"/>
                            <Border x:Name="MeterOutTrack" Grid.Column="1" Height="8" CornerRadius="4" Background="#1B1B3A" VerticalAlignment="Center">
                                <Border x:Name="MeterOut" Width="0" HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource MeterBrush}"/>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="ModeWarn" Visibility="Collapsed" Foreground="#FFB454" FontSize="11.5" TextWrapping="Wrap" Margin="0,10,0,0"/>
                        <TextBlock x:Name="InWarn" Visibility="Collapsed" Foreground="#FFB454" FontSize="11.5" TextWrapping="Wrap" Margin="0,10,0,0"
                                   Text="Input device tidak terbuka. Cek izin mikrofon Windows &amp; file driver.log."/>

                        <Image Source="Assets/asio-compatible-logo.png" Width="96" HorizontalAlignment="Left" Margin="0,20,0,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="ASIO is a registered trademark of Steinberg Media Technologies GmbH."
                                   Foreground="#6F6FA8" FontSize="9.5" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Footer -->
            <TextBlock x:Name="Footer" Grid.Row="2" Foreground="#6F6FA8" FontSize="11.5"/>
        </Grid>
    </Border>
    </Viewbox>

    <!-- pegangan resize (proporsional) -->
    <Thumb HorizontalAlignment="Right" Width="8" Margin="0,30,0,30" Cursor="SizeWE" Background="Transparent" DragDelta="GripR_Delta" DragCompleted="Grip_Done"/>
    <Thumb VerticalAlignment="Bottom" Height="8" Margin="30,0,30,0" Cursor="SizeNS" Background="Transparent" DragDelta="GripB_Delta" DragCompleted="Grip_Done"/>
    <Thumb HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="24" Height="24" Cursor="SizeNWSE" DragDelta="GripC_Delta" DragCompleted="Grip_Done">
        <Thumb.Template>
            <ControlTemplate TargetType="Thumb">
                <Grid Background="Transparent">
                    <Path Data="M 18,8 L 8,18 M 18,13 L 13,18" Stroke="#8F8FC8" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Grid>
            </ControlTemplate>
        </Thumb.Template>
    </Thumb>
    </Grid>
</Window>
